{
  "name": "nimbalodge-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "description": "NimbaLodge ERP — monorepo (apps/web, apps/api, packages/ui, packages/utils). Le prototype legacy est archivé dans docs/legacy/nimbalodge-app/, hors workspaces.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @nimbalodge/web",
    "build:web": "npm run build -w @nimbalodge/web",
    "build:ui": "npm run build -w @nimbalodge/ui --if-present",
    "dev:api": "dotenv -e .env -- npm run dev -w @nimbalodge/api",
    "build:api": "npm run build -w @nimbalodge/api",
    "start:api": "node apps/api/dist/main.js",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "db:seed": "prisma db seed --schema=prisma/schema.prisma",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "bootstrap:production": "ts-node --project prisma/tsconfig.json prisma/bootstrap-production.ts",
    "build:bootstrap": "tsc --project prisma/tsconfig.json",
    "bootstrap:production:compiled": "node prisma/dist/bootstrap-production.js",
    "db:test:setup": "dotenv -e .env.test -- node scripts/setup-test-db.js",
    "test:api:e2e": "dotenv -e .env.test -- jest --config apps/api/test/jest-e2e.json --runInBand"
  },
  "prisma": {
    "seed": "ts-node --project prisma/tsconfig.json prisma/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "prisma": "^5.19.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.5.4",
    "dotenv-cli": "^7.4.2"
  }
}
