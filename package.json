{
  "name": "nimbalodge-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "description": "NimbaLodge ERP — monorepo (apps/web, apps/api, packages/ui, packages/utils). Le prototype legacy nimbalodge-app/ reste hors workspaces.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @nimbalodge/web",
    "build:web": "npm run build -w @nimbalodge/web",
    "build:ui": "npm run build -w @nimbalodge/ui --if-present",
    "dev:api": "dotenv -e .env -- npm run dev -w @nimbalodge/api",
    "build:api": "npm run build -w @nimbalodge/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "db:seed": "prisma db seed --schema=prisma/schema.prisma",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "prisma": {
    "seed": "ts-node --project prisma/tsconfig.json prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.5.4",
    "bcryptjs": "^2.4.3",
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.19.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
