# Copier ce fichier en .env (non commité) et ajuster le mot de passe avant `npm run db:up`.

# --- PostgreSQL (Docker) ---
POSTGRES_USER=nimbalodge
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_DB=nimbalodge
POSTGRES_PORT=5432

# --- Prisma ---
# Doit rester cohérent avec les 4 variables POSTGRES_* ci-dessus (Docker Compose ne dérive pas
# automatiquement une URL de connexion).
DATABASE_URL="postgresql://nimbalodge:change-me-in-local-env@localhost:5432/nimbalodge?schema=public"

# --- apps/api ---
API_PORT=4000
CORS_ORIGIN=http://localhost:5174
NODE_ENV=development

# --- Auth (Phase 3) ---
# Générer des secrets forts et distincts, ex. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=change-me-generate-a-strong-random-secret
JWT_REFRESH_SECRET=change-me-generate-a-different-strong-random-secret
# Étape 7 — secret distinct du 2FA challenge token (voir two-factor.service.ts), jamais partagé
# avec JWT_ACCESS_SECRET.
JWT_2FA_CHALLENGE_SECRET=change-me-generate-a-third-strong-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Nimba AI (Étape 6) — optionnelles : l'app démarre normalement sans elles, Nimba AI reste en
# mode "données seules" (Insights/Anomalies sans synthèse en langage naturel, Assistant
# indisponible avec un message clair). Clé obtenue sur https://aistudio.google.com (free tier).
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=change-me-get-a-free-key-from-aistudio.google.com
# GEMINI_MODEL=gemini-3.6-flash
