# Copier ce fichier en .env.test (non commité) — base de test dédiée, distincte de .env (dev)
# et de la production. Réutilise le même serveur PostgreSQL local (`npm run db:up`), juste une
# base différente : `npm run db:test:setup` la crée si nécessaire et y applique les migrations.
# Chaque suite e2e réinitialise (`TRUNCATE ... CASCADE`) et reconstruit ses propres données via
# apps/api/test/support/ — jamais de partage d'état avec la base de dev.

# --- PostgreSQL (même conteneur Docker que .env, base différente) ---
DATABASE_URL="postgresql://nimbalodge:change-me-in-local-env@localhost:5432/nimbalodge_test?schema=public"

# --- apps/api ---
API_PORT=4001
CORS_ORIGIN=http://localhost:5174
NODE_ENV=test

# --- Auth — secrets dédiés aux tests, jamais réutilisés en dev/prod ---
JWT_ACCESS_SECRET=test-access-secret-do-not-use-outside-automated-tests
JWT_REFRESH_SECRET=test-refresh-secret-do-not-use-outside-automated-tests
JWT_2FA_CHALLENGE_SECRET=test-2fa-challenge-secret-do-not-use-outside-automated-tests
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
